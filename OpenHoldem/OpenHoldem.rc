IDD_ABOUTBOX DIALOGEX 0, 0, 266, 157
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About this program"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,21,20
    LTEXT           "OpenHoldem",IDC_STATIC,32,10,208,8,SS_NOPREFIX
    LTEXT           "Version 14.0.2.0",IDC_STATIC,32,22,208,8,SS_NOPREFIX
    LTEXT           "Licensed under GPLv3",IDC_STATIC,32,34,208,8
    LTEXT           "http://www.maxinmontreal.com/forums/index.php",IDC_STATIC,32,54,208,8
    LTEXT           "https://github.com/OpenHoldem/openholdembot/",IDC_STATIC,32,66,208,8
    LTEXT           "http://www.gnu.org/licenses/gpl.html",IDC_STATIC,32,78,208,8
    LTEXT           "Disclaimer: this is an open-source project.",IDC_STATIC,32,98,208,8,SS_NOPREFIX
    LTEXT           "We are not related to any shops, stores and/or scam-artists.",IDC_STATIC,32,110,208,8,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,108,134,50,16,WS_GROUP
END

IDD_PREFERENCES DIALOGEX 0, 0, 440, 300
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OpenHoldem Preferences"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

IDD_RENAME DIALOGEX 0, 0, 186, 71
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_NEWNAME_EDIT,48,30,131,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,75,50,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,129,50,50,14
    EDITTEXT        IDC_OLDNAME_EDIT,48,7,131,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Old Name:",IDC_STATIC,7,10,34,8
    LTEXT           "New Name:",IDC_STATIC,7,33,38,8
END

IDD_NEW DIALOGEX 0, 0, 156, 63
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_NEWNAME_EDIT,7,19,142,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,45,42,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,99,42,50,14
    LTEXT           "New xxx name:",IDC_DESC,7,7,51,8
END

IDD_FORMULA_SCINTILLA DIALOGEX 0, 0, 332, 232
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Formula Editor"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_SCINTILLA_FORMULA_TREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | TVS_SHOWSELALWAYS | TVS_INFOTIP | WS_BORDER | WS_TABSTOP,7,26,105,178,WS_EX_TRANSPARENT
    CONTROL         "",IDC_SYMBOL_TREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_INFOTIP | NOT WS_VISIBLE | WS_BORDER | WS_TABSTOP,7,25,105,178
    PUSHBUTTON      "Calc",IDC_SCINTILLA_CALC,219,7,50,14
    CONTROL         "ScntillaCtrl",IDC_SCINCTRL,"Scintilla",WS_TABSTOP,116,25,208,178
    PUSHBUTTON      "Apply",IDC_SCINTILLA_APPLY,223,222,50,14
    PUSHBUTTON      "&Close",IDCANCEL,275,222,50,14
    EDITTEXT        IDC_SCINTILLA_CALC_RESULT,60,7,60,14,ES_AUTOHSCROLL | ES_READONLY,WS_EX_STATICEDGE
    EDITTEXT        IDC_SCINTILLA_CALC_LINE,140,7,60,14,ES_AUTOHSCROLL | ES_READONLY,WS_EX_STATICEDGE
    CONTROL         "Auto",IDC_SCINTILLA_AUTO,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP,275,7,50,14
    CONTROL         "",IDC_FORMULA_TAB,"SysTabControl32",TCS_BOTTOM,7,203,105,14,WS_EX_TRANSPARENT
    CONTROL         "",IDC_FUNCTIONS_TAB,"SysTabControl32",TCS_BOTTOM,116,204,207,14,WS_EX_TRANSPARENT
    EDITTEXT        IDC_SEARCH_ED,7,7,105,14,ES_AUTOHSCROLL
END

IDD_SCRAPER_OUTPUT DIALOGEX 0, 0, 233, 145
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Scraper Output"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LISTBOX         IDC_REGIONLIST,7,7,64,131,LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    CONTROL         "",IDC_SCRAPERBITMAP,"Static",SS_BLACKFRAME,77,7,149,115
    COMBOBOX        IDC_ZOOM,98,126,47,30,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_SCRAPERRESULT,176,124,50,14,ES_AUTOHSCROLL
    LTEXT           "Zoom:",IDC_STATIC_ZOOM,75,129,21,8
    LTEXT           "Result:",IDC_STATIC_RESULT,150,130,24,8
END

IDD_HANDLIST DIALOGEX 0, 0, 300, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hand List Editor"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Hand list: x",IDC_HANDLIST_NAME,12,10,120,12
    LTEXT           "Static",IDC_COMMENT,150,10,138,12,SS_RIGHT
    PUSHBUTTON      "All pairs",IDANYPP,12,300,44,18
    PUSHBUTTON      "Broadways",IDBROADWAYS,60,300,50,18
    PUSHBUTTON      "All suited",IDALLSUITED,114,300,46,18
    PUSHBUTTON      "Clear",IDCLEAR,164,300,34,18
    DEFPUSHBUTTON   "OK",IDOK,204,300,40,18
    PUSHBUTTON      "Cancel",IDCANCEL,248,300,40,18
END


