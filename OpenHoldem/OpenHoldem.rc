/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",               ID_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+A",         ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Recent File",                 ID_FILE_MRU_FILE1
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Formula\tCtrl+F",            ID_EDIT_FORMULA
        MENUITEM "&Preferences\tCtrl+P",        ID_EDIT_PREFERENCES
        MENUITEM SEPARATOR
        MENUITEM "&Tag Log-File\tF5",           ID_EDIT_TAGLOG
        MENUITEM "&View Log-File\tF6",          ID_EDIT_VIEWLOG
        MENUITEM "&Clear Log-File",             ID_EDIT_CLEARLOG
        MENUITEM SEPARATOR
        MENUITEM "View Scraper &Output\tF11",   ID_VIEW_SCRAPEROUTPUT
        MENUITEM "Shoot &Replay Frame\tF12",    ID_VIEW_SHOOTREPLAYFRAME
    END
    MENUITEM "&Problem Solver",             ID_HELP_PROBLEMSOLVER
    POPUP "&Help"
    BEGIN
        MENUITEM "Open&Holdem Manual\tF1",      ID_HELP_HELP
        MENUITEM "&OpenPPL Manual\tF2",         ID_HELP_OPEN_PPL
        MENUITEM "&Forums",                     ID_HELP_FORUMS
        MENUITEM SEPARATOR
        MENUITEM "&Problem Solver",             ID_HELP_PROBLEMSOLVER
        MENUITEM SEPARATOR
        MENUITEM "&About This Program...",      ID_APP_ABOUT
    END
END

IDR_FORMULA_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Apply",                      ID_FORMULA_FILE_APPLY
        MENUITEM "&Save",                       ID_FILE_SAVE
        MENUITEM "&Close",                      ID_FORMULA_FILE_CANCEL
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&New",                        ID_FORMULA_EDIT_NEW
        MENUITEM "&Rename",                     ID_FORMULA_EDIT_RENAME
        MENUITEM "&Delete",                     ID_FORMULA_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Undo\tCtrl+Z",                ID_FORMULA_EDIT_UNDO
        MENUITEM "Redo\tCtrl+Y",                ID_FORMULA_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Find\tCtrl+F",                ID_FORMULA_EDIT_FIND
        MENUITEM "Find Next\tF3",               ID_FORMULA_EDIT_FIND_NEXT
        MENUITEM "Find Previous\t Shift-F3",    ID_FORMULA_EDIT_FIND_PREV
        MENUITEM SEPARATOR
        MENUITEM "Cut\tCtrl+X",                 ID_FORMULA_EDIT_CUT
        MENUITEM "Copy\tCtrl+C",                ID_FORMULA_EDIT_COPY
        MENUITEM "Paste\tCtrl+V",               ID_FORMULA_EDIT_PASTE
        MENUITEM "Delete Text\tCtrl+D",         ID_FORMULA_EDIT_DELETE_TEXT
        MENUITEM SEPARATOR
        MENUITEM "Select All\tCtrl+A",          ID_FORMULA_EDIT_SELECTALL
        MENUITEM SEPARATOR
        MENUITEM "&Hand List",                  ID_FORMULA_EDIT_HANDLIST
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Word Wrap\tAlt+Z",           ID_FORMULA_VIEW_WORDWRAP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "Open&Holdem Manual\tF1",      ID_HELP_HELP
        MENUITEM "&OpenPPL Manual",             ID_HELP_OPEN_PPL
        MENUITEM "&Forums",                     ID_HELP_FORUMS
        MENUITEM SEPARATOR
        MENUITEM "&About this program...",      ID_APP_ABOUT
    END
END

IDR_FORMULA_SYMBOL_MENU MENU
