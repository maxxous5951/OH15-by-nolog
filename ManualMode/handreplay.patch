+/*****************************************************
+*
+* Hand replay: simulate recorded (PokerStars) hands
+*
+* The whole table is rebuilt from the hand-history for every step,
+* so stepping backwards is as simple as stepping forwards.
+* PokerStars seat N is chair N-1. Everybody gets card-backs,
+* except the hero (real cards) and players who showed their hand.
+* All controls live in the independent CHandReplayDlg window;
+* this window looks exactly like before.
+*
+*****************************************************/
+
+unsigned int CManualModeDlg::CardFromString(const std::string& s)
+{
+	if (s.length() < 2) return CARD_NOCARD;
+	char r = (char)tolower((unsigned char)s[0]);
+	if (r == 0 || strchr("23456789tjqka", r) == NULL) return CARD_NOCARD;
+	int suit;
+	switch (tolower((unsigned char)s[1]))
+	{
+		case 'c': suit = Suit_CLUBS; break;
+		case 'd': suit = Suit_DIAMONDS; break;
+		case 'h': suit = Suit_HEARTS; break;
+		case 's': suit = Suit_SPADES; break;
+		default: return CARD_NOCARD;
+	}
+	return StdDeck_MAKE_CARD(get_rank(r), suit);
+}
+
+bool CManualModeDlg::ImportHand(const CString& text, const CString& hero_name, CString* error)
+{
+	std::vector<HandHistory::Hand> hands;
+	std::string parse_error;
+	if (!HandHistory::ParseAll((LPCTSTR)text, &hands, &parse_error))
+	{
+		*error = parse_error.c_str();
+		return false;
+	}
+	CString hero_trimmed = hero_name;
+	hero_trimmed.Trim();
+	const std::string wanted = (LPCTSTR)hero_trimmed;
+
+	// Hero of every hand: the requested name if seated there,
+	// otherwise the player of the "Dealt to" line of that hand.
+	std::vector<std::string> heroes;
+	size_t hands_with_hero = 0;
+	for (size_t h = 0; h < hands.size(); ++h)
+	{
+		std::string hero = hands[h].default_hero;
+		for (size_t i = 0; i < hands[h].seats.size(); ++i)
+		{
+			if (!wanted.empty() && hands[h].seats[i].name == wanted) hero = wanted;
+		}
+		if (!hero.empty()) ++hands_with_hero;
+		heroes.push_back(hero);
+	}
+	if (hands_with_hero == 0)
+	{
+		if (wanted.empty())
+			*error = "No \"Dealt to\" line found.\nPlease enter the name of the hero.";
+		else
+			error->Format("Hero \"%s\" is not seated in any of these hands.\nPlease enter the exact player name.", wanted.c_str());
+		return false;
+	}
+
+	hh_hands = hands;
+	hh_heroes = heroes;
+	hh_loaded = true;
+	SelectHand(0);
+	ApplyHandStep();
+	return true;
+}
+
+// Makes hand <index> the current one, at step 0 (the caller applies the step)
+void CManualModeDlg::SelectHand(size_t index)
+{
+	if (index >= hh_hands.size()) return;
+	hh_index = index;
+	hh_hand = hh_hands[index];
+	hh_hero = hh_heroes[index];
+	hh_step = 0;
+
+	// Game info (the same values as in the "white box")
+	if (hh_hand.bblind > 0)
+	{
+		sblind = NumberToFormattedString(hh_hand.sblind);
+		bblind = NumberToFormattedString(hh_hand.bblind);
+		bbet = NumberToFormattedString(hh_hand.bblind * 2);
+	}
+	ante = NumberToFormattedString(hh_hand.ante);
+	limit = hh_hand.limit;
+	istournament = hh_hand.tournament;
+	isomaha = hh_hand.omaha;
+	network = "Stars";
+	if (!hh_hand.hand_id.empty()) handnumber = hh_hand.hand_id.c_str();
+}
+
+bool CManualModeDlg::NextHand()
+{
+	if (!hh_loaded || hh_index + 1 >= hh_hands.size()) return false;
+	SelectHand(hh_index + 1);
+	ApplyHandStep();
+	return true;
+}
+
+bool CManualModeDlg::PrevHand()
+{
+	if (!hh_loaded || hh_index == 0) return false;
+	SelectHand(hh_index - 1);
+	ApplyHandStep();
+	return true;
+}
+
+bool CManualModeDlg::HandStepNext()
+{
+	if (!hh_loaded || hh_step >= hh_hand.events.size()) return false;
+	++hh_step;
+	ApplyHandStep();
+	return true;
+}
+
+bool CManualModeDlg::HandStepPrev()
+{
+	if (!hh_loaded || hh_step == 0) return false;
+	--hh_step;
+	ApplyHandStep();
+	return true;
+}
+
+// Jumps to the next situation where the hero has to act.
+// Starts strictly after the current step and goes on in the following hands.
+bool CManualModeDlg::HandStepToDecision()
+{
+	if (!hh_loaded) return false;
+	for (size_t h = hh_index; h < hh_hands.size(); ++h)
+	{
+		const HandHistory::Hand& hand = hh_hands[h];
+		size_t first = (h == hh_index) ? hh_step + 1 : 0;
+		for (size_t i = first; i < hand.events.size(); ++i)
+		{
+			if (HandHistory::IsDecision(hand.events[i], hh_heroes[h]))
+			{
+				if (h != hh_index) SelectHand(h);
+				hh_step = i;  // state right before the hero's action
+				ApplyHandStep();
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+// Is the next action of the hand one of the hero?
+bool CManualModeDlg::HeroToAct()
+{
+	if (!hh_loaded || hh_step >= hh_hand.events.size()) return false;
+	return HandHistory::IsDecision(hh_hand.events[hh_step], hh_hero);
+}
+
+CString CManualModeDlg::HandStatus()
+{
+	CString status;
+	if (!hh_loaded)
+	{
+		status = "No hand loaded.\nPaste one or more hand-histories above and click Load.";
+		return status;
+	}
+	status.Format("Hand %u / %u  (#%s)    Step %u / %u\n",
+		(unsigned)(hh_index + 1), (unsigned)hh_hands.size(), hh_hand.hand_id.c_str(),
+		(unsigned)hh_step, (unsigned)hh_hand.events.size());
+	if (hh_step < hh_hand.events.size())
+	{
+		status += HeroToAct() ? "HERO TO ACT: " : "Next: ";
+		status += hh_hand.events[hh_step].text.c_str();
+	}
+	else
+	{
+		status += "End of hand.";
+	}
+	return status;
+}
+
+// Arrow keys etc. also work while the ManualMode window has the focus
+BOOL CManualModeDlg::PreTranslateMessage(MSG* pMsg)
+{
+	if (pMsg->message == WM_KEYDOWN && handreplay.GetSafeHwnd() != NULL)
+	{
+		if (handreplay.HandleShortcut((UINT)pMsg->wParam)) return TRUE;
+	}
+	return CDialog::PreTranslateMessage(pMsg);
+}
+
+void CManualModeDlg::ApplyHandStep()
+{
+	if (!hh_loaded) return;
+	const HandHistory::State s = HandHistory::Replay(hh_hand, hh_hero, hh_step);
+
+	// Board
+	CardMask_RESET(used_cards);
+	for (int i = 0; i < kNumberOfCommunityCards; ++i)
+	{
+		card[CC0 + i] = CARD_NOCARD;
+	}
+	int ncommon = 0;
+	for (size_t i = 0; i < s.board.size() && i < (size_t)kNumberOfCommunityCards; ++i)
+	{
+		unsigned int c = CardFromString(s.board[i]);
+		card[CC0 + i] = c;
+		if (c != CARD_NOCARD)
+		{
+			CardMask_SET(used_cards, c);
+			++ncommon;
+		}
+	}
+	// Keep do_scrape_bets_into_pot() consistent if the user continues manually
+	ncommoncards_last = ncommon;
+	pot = s.pot;
+
+	// Players: start with empty chairs, then fill the seats of the hand
+	for (int i = 0; i < kMaxNumberOfPlayers; ++i)
+	{
+		seated[i] = active[i] = dealer[i] = false;
+		for (int j = 0; j < kNumberOfCardsPerPlayerOmaha; ++j)
+		{
+			SetPlayerCard(i, j, CARD_NOCARD);
+		}
+		playername[i].Format("Player%d", i);
+		playerbalance[i] = "0";
+		playerbet[i] = "0";
+	}
+	for (size_t k = 0; k < hh_hand.seats.size(); ++k)
+	{
+		const HandHistory::Seat& seat = hh_hand.seats[k];
+		int chair = seat.seat - 1;
+		if (chair < 0 || chair >= kMaxNumberOfPlayers) continue;
+		std::map<std::string, HandHistory::PlayerState>::const_iterator it = s.players.find(seat.name);
+		if (it == s.players.end()) continue;
+		const HandHistory::PlayerState& p = it->second;
+
+		seated[chair] = true;
+		// A folded player stays "sat in" (like ManualMode's own fold), just without cards
+		active[chair] = p.in_hand;
+		dealer[chair] = (seat.seat == hh_hand.button_seat);
+		playername[chair] = seat.name.c_str();
+		playerbalance[chair] = NumberToFormattedString(p.stack);
+		playerbet[chair] = NumberToFormattedString(p.bet);
+
+		if (!p.in_hand || p.folded) continue;
+		for (int j = 0; j < kNumberOfCardsPerPlayerOmaha; ++j)
+		{
+			unsigned int c = CARD_BACK;
+			if (j < (int)p.cards.size())
+			{
+				unsigned int real = CardFromString(p.cards[j]);
+				if (real != CARD_NOCARD)
+				{
+					c = real;
+					CardMask_SET(used_cards, real);
+				}
+			}
+			SetPlayerCard(chair, j, c);
+		}
+	}
+	// Dealer button: if the button seat is empty, keep it somewhere valid
+	bool any_dealer = false;
+	for (int i = 0; i < kMaxNumberOfPlayers; ++i) any_dealer = any_dealer || dealer[i];
+	if (!any_dealer) dealer[0] = true;
+
+	// Is it the hero's turn? Then show the action buttons like a real table.
+	for (int i = 0; i < 5; ++i) buttonstate[i] = false;
+	if (HeroToAct())
+	{
+		double current_bet = 0;
+		for (std::map<std::string, HandHistory::PlayerState>::const_iterator it = s.players.begin(); it != s.players.end(); ++it)
+		{
+			if (it->second.bet > current_bet) current_bet = it->second.bet;
+		}
+		const HandHistory::PlayerState& hero = s.players.find(hh_hero)->second;
+		buttonstate[0] = true;                                  // fold
+		if (hero.bet >= current_bet) buttonstate[2] = true;     // check
+		else buttonstate[1] = true;                             // call
+		if (hero.stack + hero.bet > current_bet) buttonstate[3] = true;  // raise
+		if (limit != LIMIT_FL) buttonstate[4] = true;           // allin
+	}
+
+	InvalidateRect(NULL, true);
+}
