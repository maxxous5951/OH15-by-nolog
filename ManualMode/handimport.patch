+/*****************************************************
+*
+* Hand-history import: replay a recorded (PokerStars) hand
+*
+* The whole table is rebuilt from the hand-history for every step,
+* so stepping backwards is as simple as stepping forwards.
+* PokerStars seat N is chair N-1. Everybody gets card-backs,
+* except the hero (real cards) and players who showed their hand.
+*
+*****************************************************/
+
+unsigned int CManualModeDlg::CardFromString(const std::string& s)
+{
+	if (s.length() < 2) return CARD_NOCARD;
+	char r = (char)tolower((unsigned char)s[0]);
+	if (r == 0 || strchr("23456789tjqka", r) == NULL) return CARD_NOCARD;
+	int suit;
+	switch (tolower((unsigned char)s[1]))
+	{
+		case 'c': suit = Suit_CLUBS; break;
+		case 'd': suit = Suit_DIAMONDS; break;
+		case 'h': suit = Suit_HEARTS; break;
+		case 's': suit = Suit_SPADES; break;
+		default: return CARD_NOCARD;
+	}
+	return StdDeck_MAKE_CARD(get_rank(r), suit);
+}
+
+void CManualModeDlg::OnBnClickedImport()
+{
+	CImportHandDlg dlg;
+	dlg.m_text = hh_text;
+	dlg.m_hero = hh_hero.c_str();
+	if (dlg.DoModal() != IDOK) return;
+
+	HandHistory::Hand hand;
+	std::string error;
+	if (!HandHistory::Parse((LPCTSTR)dlg.m_text, &hand, &error))
+	{
+		MessageBox(error.c_str(), "Import hand", MB_ICONWARNING);
+		return;
+	}
+	std::string hero = (LPCTSTR)dlg.m_hero;
+	if (hero.empty()) hero = hand.default_hero;
+	bool hero_found = false;
+	for (size_t i = 0; i < hand.seats.size(); ++i)
+	{
+		if (hand.seats[i].name == hero) hero_found = true;
+	}
+	if (!hero_found)
+	{
+		CString msg;
+		msg.Format("Hero \"%s\" is not seated in this hand.\nPlease enter the exact player name.", hero.c_str());
+		MessageBox(msg, "Import hand", MB_ICONWARNING);
+		return;
+	}
+
+	// Game info (the same values as in the "white box")
+	if (hand.bblind > 0)
+	{
+		sblind = NumberToFormattedString(hand.sblind);
+		bblind = NumberToFormattedString(hand.bblind);
+		bbet = NumberToFormattedString(hand.bblind * 2);
+	}
+	ante = NumberToFormattedString(hand.ante);
+	limit = hand.limit;
+	istournament = hand.tournament;
+	isomaha = hand.omaha;
+	network = "Stars";
+	if (!hand.hand_id.empty()) handnumber = hand.hand_id.c_str();
+
+	hh_text = dlg.m_text;
+	hh_hand = hand;
+	hh_hero = hero;
+	hh_loaded = true;
+	hh_step = 0;
+	ApplyHandStep();
+}
+
+void CManualModeDlg::OnBnClickedHandNext()
+{
+	if (!hh_loaded)
+	{
+		MessageBox("Please import a hand first (button \"Import\").", "Hand replay", MB_ICONINFORMATION);
+		return;
+	}
+	if (hh_step < hh_hand.events.size())
+	{
+		++hh_step;
+		ApplyHandStep();
+	}
+}
+
+void CManualModeDlg::OnBnClickedHandPrev()
+{
+	if (!hh_loaded) return;
+	if (hh_step > 0)
+	{
+		--hh_step;
+		ApplyHandStep();
+	}
+}
+
+void CManualModeDlg::ApplyHandStep()
+{
+	if (!hh_loaded) return;
+	const HandHistory::State s = HandHistory::Replay(hh_hand, hh_hero, hh_step);
+
+	// Board
+	CardMask_RESET(used_cards);
+	for (int i = 0; i < kNumberOfCommunityCards; ++i)
+	{
+		card[CC0 + i] = CARD_NOCARD;
+	}
+	int ncommon = 0;
+	for (size_t i = 0; i < s.board.size() && i < (size_t)kNumberOfCommunityCards; ++i)
+	{
+		unsigned int c = CardFromString(s.board[i]);
+		card[CC0 + i] = c;
+		if (c != CARD_NOCARD)
+		{
+			CardMask_SET(used_cards, c);
+			++ncommon;
+		}
+	}
+	// Keep do_scrape_bets_into_pot() consistent if the user continues manually
+	ncommoncards_last = ncommon;
+	pot = s.pot;
+
+	// Players: start with empty chairs, then fill the seats of the hand
+	for (int i = 0; i < kMaxNumberOfPlayers; ++i)
+	{
+		seated[i] = active[i] = dealer[i] = false;
+		for (int j = 0; j < kNumberOfCardsPerPlayerOmaha; ++j)
+		{
+			SetPlayerCard(i, j, CARD_NOCARD);
+		}
+		playername[i].Format("Player%d", i);
+		playerbalance[i] = "0";
+		playerbet[i] = "0";
+	}
+	for (size_t k = 0; k < hh_hand.seats.size(); ++k)
+	{
+		const HandHistory::Seat& seat = hh_hand.seats[k];
+		int chair = seat.seat - 1;
+		if (chair < 0 || chair >= kMaxNumberOfPlayers) continue;
+		std::map<std::string, HandHistory::PlayerState>::const_iterator it = s.players.find(seat.name);
+		if (it == s.players.end()) continue;
+		const HandHistory::PlayerState& p = it->second;
+
+		seated[chair] = true;
+		// A folded player stays "sat in" (like ManualMode's own fold), just without cards
+		active[chair] = p.in_hand;
+		dealer[chair] = (seat.seat == hh_hand.button_seat);
+		playername[chair] = seat.name.c_str();
+		playerbalance[chair] = NumberToFormattedString(p.stack);
+		playerbet[chair] = NumberToFormattedString(p.bet);
+
+		if (!p.in_hand || p.folded) continue;
+		for (int j = 0; j < kNumberOfCardsPerPlayerOmaha; ++j)
+		{
+			unsigned int c = CARD_BACK;
+			if (j < (int)p.cards.size())
+			{
+				unsigned int real = CardFromString(p.cards[j]);
+				if (real != CARD_NOCARD)
+				{
+					c = real;
+					CardMask_SET(used_cards, real);
+				}
+			}
+			SetPlayerCard(chair, j, c);
+		}
+	}
+	// Dealer button: if the button seat is empty, keep it somewhere valid
+	bool any_dealer = false;
+	for (int i = 0; i < kMaxNumberOfPlayers; ++i) any_dealer = any_dealer || dealer[i];
+	if (!any_dealer) dealer[0] = true;
+
+	// Is it the hero's turn? Then show the action buttons like a real table.
+	for (int i = 0; i < 5; ++i) buttonstate[i] = false;
+	bool hero_to_act = false;
+	if (hh_step < hh_hand.events.size())
+	{
+		const HandHistory::Event& next = hh_hand.events[hh_step];
+		hero_to_act = (next.player == hh_hero) &&
+			(next.type == HandHistory::Event::Fold || next.type == HandHistory::Event::Check ||
+			 next.type == HandHistory::Event::Call || next.type == HandHistory::Event::Bet ||
+			 next.type == HandHistory::Event::Raise);
+	}
+	if (hero_to_act)
+	{
+		double current_bet = 0;
+		for (std::map<std::string, HandHistory::PlayerState>::const_iterator it = s.players.begin(); it != s.players.end(); ++it)
+		{
+			if (it->second.bet > current_bet) current_bet = it->second.bet;
+		}
+		const HandHistory::PlayerState& hero = s.players.find(hh_hero)->second;
+		buttonstate[0] = true;                                  // fold
+		if (hero.bet >= current_bet) buttonstate[2] = true;     // check
+		else buttonstate[1] = true;                             // call
+		if (hero.stack + hero.bet > current_bet) buttonstate[3] = true;  // raise
+		if (limit != LIMIT_FL) buttonstate[4] = true;           // allin
+	}
+
+	// Status line next to the buttons
+	CString status, line;
+	status.Format("%u/%u  ", (unsigned)hh_step, (unsigned)hh_hand.events.size());
+	if (hh_step < hh_hand.events.size())
+	{
+		line = hero_to_act ? "HERO TO ACT: " : "next: ";
+		line += hh_hand.events[hh_step].text.c_str();
+	}
+	else
+	{
+		line = "end of hand";
+	}
+	status += line;
+	SetDlgItemText(IDC_HAND_STATUS, status);
+
+	InvalidateRect(NULL, true);
+}
